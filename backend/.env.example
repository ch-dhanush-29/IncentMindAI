# ==========================================
# IncidentMind AI - Backend Configuration
# ==========================================

# Application Environment
ENVIRONMENT=development
PROJECT_NAME="IncidentMind AI"
API_V1_PREFIX=/api
DEMO_MODE=true

# MongoDB Configuration
# Local instance or MongoDB Atlas connection URI:
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=incidentmind_db

# Vectorize Hindsight Agent Memory
# Official Docs: https://hindsight.vectorize.io/
# Cloud Console: https://ui.hindsight.vectorize.io
HINDSIGHT_API_KEY=your_hindsight_api_key_here
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
HINDSIGHT_BANK_ID=incidentmind-prod-bank
HINDSIGHT_ENABLED=true

# Groq High-Speed LLM Inference
# Official: https://groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
# Supported alternatives: openai/gpt-oss-120b, qwen/qwen3-32b

# Security Secrets
SECRET_KEY=generate-a-secure-random-token-for-production
