# ==========================================
# IncidentMind AI - Environment Configuration Example
# Copy this file to .env and provide your credentials.
# ==========================================

# Application Settings
ENVIRONMENT=development
PROJECT_NAME="IncidentMind AI"
API_V1_PREFIX=/api
DEMO_MODE=true

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=incidentmind_db

# Vectorize Hindsight Persistent Memory
HINDSIGHT_API_KEY=your_hindsight_api_key_here
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
HINDSIGHT_BANK_ID=incidentmind-prod-bank
HINDSIGHT_ENABLED=true

# Groq High-Speed LLM Inference
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Security Secrets
SECRET_KEY=generate-a-secure-random-token-for-production
