# ==========================================
# IncidentMind AI - Production Environment Variables
# Copy this file to .env and configure your credentials.
# ==========================================

# ------------------------------------------
# 1. Core Application
# ------------------------------------------
ENVIRONMENT=development
PROJECT_NAME="IncidentMind AI Enterprise"
API_V1_PREFIX=/api
DEMO_MODE=true
SECRET_KEY=generate-a-secure-random-token-for-production

# ------------------------------------------
# 2. Vectorize Hindsight Cloud API (Persistent Vector Memory)
# Get credentials at: https://vectorize.io
# ------------------------------------------
HINDSIGHT_API_KEY=your_hindsight_api_key_here
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
HINDSIGHT_BANK_ID=incidentmind-prod-bank
HINDSIGHT_ENABLED=true

# ------------------------------------------
# 3. Slack Bot & Incident War Room Integration
# Create a Slack App at: https://api.slack.com/apps
# Scopes needed: chat:write, commands, incoming-webhook
# ------------------------------------------
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_SIGNING_SECRET=your_slack_signing_secret
SLACK_DEFAULT_CHANNEL=#incidents-war-room
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
SLACK_ENABLED=true

# ------------------------------------------
# 4. Clerk Authentication & Single Sign-On (SSO / RBAC)
# Create Clerk application at: https://clerk.com
# ------------------------------------------
CLERK_PUBLISHABLE_KEY=pk_test_..._or_pk_live_...
CLERK_SECRET_KEY=sk_test_..._or_sk_live_...
CLERK_JWKS_URL=https://api.clerk.com/v1/jwks
AUTH_ENABLED=false

# ------------------------------------------
# 5. Groq Fast LPU Inference (Llama-3.3-70B)
# Get API key at: https://console.groq.com/keys
# ------------------------------------------
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ------------------------------------------
# 6. MongoDB Database (Local or MongoDB Atlas)
# MongoDB Atlas: mongodb+srv://<user>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
# ------------------------------------------
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=incidentmind_db
